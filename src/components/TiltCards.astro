---
// Tarjetas de proyecto con inclinación 3D (módulo aislado, fácil de quitar)
// Usa vanilla-tilt. Se re-aplica tras la navegación (ViewTransitions).
---

<script>
  import VanillaTilt from "vanilla-tilt";

  const prefersReduced = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;

  function initTilt() {
    if (prefersReduced) return;
    const cards = document.querySelectorAll<HTMLElement>(".project-card");
    cards.forEach((card) => {
      // Evita duplicados si ya está inicializada
      if ((card as any).vanillaTilt) return;
      VanillaTilt.init(card, {
        max: 8,
        speed: 500,
        glare: true,
        "max-glare": 0.25,
        scale: 1.02,
        perspective: 1200,
      });
    });
  }

  document.addEventListener("astro:page-load", initTilt);
  initTilt();
</script>
