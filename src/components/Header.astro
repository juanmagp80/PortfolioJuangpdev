---
import ThemeToggle from "./ThemeToggle.astro";

const navItems = [
  {
    title: "Experiencia",
    label: "experiencia",
    url: "/#experiencia",
  },
  {
    title: "Tecnologías",
    label: "tecnologias",
    url: "/#tecnologias",
  },
  {
    title: "Certificaciones",
    label: "certificaciones",
    url: "/#certificaciones",
  },
  {
    title: "Proyectos",
    label: "proyectos",
    url: "/#proyectos",
  },
  {
    title: "Sobre mí",
    label: "sobre-mi",
    url: "/#sobre-mi",
  },
  {
    title: "Contacto",
    label: "contacto",
    url: "mailto:juangpdev@gmail.com",
  },
  {
    title: "CV",
    label: "CV",
    url: "./JuanManuelGarrido.pdf",
    download: true,
  },
];
---

<header class="fixed top-0 z-50 w-full mx-auto mt-2">
  <nav
    class="flex justify-between items-center px-6 lg:px-12 py-3 text-sm font-medium text-gray-600 dark:text-gray-200 max-w-7xl mx-auto rounded-2xl transition-all duration-300"
    id="main-nav"
  >
    <!-- Theme Toggle - mejor posicionado -->
    <div class="flex items-center">
      <ThemeToggle />
    </div>

    <!-- Menú de navegación centrado (oculto en pantallas pequeñas) -->
    <div
      class="hidden lg:flex space-x-6 absolute left-1/2 transform -translate-x-1/2 items-center"
      id="nav-items"
    >
      {
        navItems.map((link) => (
          <a
            class="nav-link relative block px-3 py-2 transition-all duration-300 hover:text-blue-500 dark:hover:text-blue-400 hover:scale-105 rounded-lg hover:bg-blue-50 dark:hover:bg-blue-900/20 whitespace-nowrap"
            aria-label={link.label}
            href={link.url}
            data-section={link.label}
          >
            {link.title}
            <span class="absolute -bottom-1 left-1/2 transform -translate-x-1/2 w-0 h-0.5 bg-gradient-to-r from-blue-500 to-purple-500 transition-all duration-300 rounded-full"></span>
          </a>
        ))
      }
    </div>

    <!-- Icono del menú hamburguesa - posición derecha -->
    <button
      class="lg:hidden focus:outline-none p-2 rounded-lg transition-all duration-300 hover:bg-gray-100 dark:hover:bg-gray-800"
      id="menu-toggle"
      aria-label="Abrir menú"
    >
      <svg
        class="w-6 h-6 transition-transform duration-300"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
        id="menu-icon"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16m-7 6h7"
          id="hamburger-lines"></path>
      </svg>
    </button>
  </nav>

  <!-- Menú desplegable mejorado (solo visible en pantallas pequeñas) -->
  <div
    id="mobile-menu"
    class="hidden lg:hidden fixed top-20 left-6 right-6 bg-white/98 dark:bg-gray-900/98 backdrop-blur-xl rounded-2xl shadow-2xl border border-gray-200/50 dark:border-gray-700/50 overflow-hidden transition-all duration-300 transform max-w-sm mx-auto z-40"
  >
    <div class="p-6 space-y-4">
      {
        navItems.map((link, index) => (
          <a
            class="nav-link-mobile block w-full text-center py-3 px-4 transition-all duration-300 hover:text-blue-500 dark:hover:text-blue-400 hover:bg-blue-50 dark:hover:bg-blue-900/20 rounded-xl font-medium"
            aria-label={link.label}
            href={link.url}
            data-section={link.label}
            style={`animation-delay: ${index * 0.1}s`}
          >
            {link.title}
          </a>
        ))
      }
      <div
        class="pt-4 border-t border-gray-200 dark:border-gray-700 flex justify-center"
      >
        <ThemeToggle />
      </div>
    </div>
  </div>
</header>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const menuToggle = document.getElementById("menu-toggle");
    const mobileMenu = document.getElementById("mobile-menu");
    const menuIcon = document.getElementById("menu-icon");
    const mainNav = document.getElementById("main-nav");

    if (menuToggle && mobileMenu && menuIcon) {
      let isOpen = false;

      menuToggle.addEventListener("click", () => {
        isOpen = !isOpen;

        if (isOpen) {
          mobileMenu.classList.remove("hidden");
          mobileMenu.style.opacity = "0";
          mobileMenu.style.transform = "translateY(-10px) scale(0.95)";

          // Animación de entrada
          setTimeout(() => {
            mobileMenu.style.opacity = "1";
            mobileMenu.style.transform = "translateY(0) scale(1)";
          }, 10);

          // Rotar el icono
          menuIcon.style.transform = "rotate(90deg)";
        } else {
          mobileMenu.style.opacity = "0";
          mobileMenu.style.transform = "translateY(-10px) scale(0.95)";
          menuIcon.style.transform = "rotate(0deg)";

          setTimeout(() => {
            mobileMenu.classList.add("hidden");
          }, 300);
        }
      });

      // Cerrar al hacer clic en un enlace
      mobileMenu.addEventListener("click", (e) => {
        const target = e.target as HTMLElement;
        if (target && target.tagName === "A") {
          isOpen = false;
          mobileMenu.style.opacity = "0";
          mobileMenu.style.transform = "translateY(-10px) scale(0.95)";
          menuIcon.style.transform = "rotate(0deg)";

          setTimeout(() => {
            mobileMenu.classList.add("hidden");
          }, 300);
        }
      });

      // Cerrar al hacer clic fuera del menú
      document.addEventListener("click", (e) => {
        const target = e.target as Node;
        if (
          isOpen &&
          target &&
          !menuToggle.contains(target) &&
          !mobileMenu.contains(target)
        ) {
          isOpen = false;
          mobileMenu.style.opacity = "0";
          mobileMenu.style.transform = "translateY(-10px) scale(0.95)";
          menuIcon.style.transform = "rotate(0deg)";

          setTimeout(() => {
            mobileMenu.classList.add("hidden");
          }, 300);
        }
      });
    }

    // Active navigation
    const sections = document.querySelectorAll('[data-section]');
    const navLinks = document.querySelectorAll('.nav-link, .nav-link-mobile');
    
    const observerOptions = {
      threshold: 0.3,
      rootMargin: '-20% 0px -20% 0px'
    };

    const sectionObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const sectionId = entry.target.getAttribute('id');
          
          // Remove active class from all nav links
          navLinks.forEach(link => {
            link.classList.remove('active');
            const indicator = link.querySelector('span');
            if (indicator) {
              indicator.style.width = '0';
            }
          });
          
          // Add active class to current section link
          const activeLink = document.querySelector(`[data-section="${sectionId}"]`);
          if (activeLink) {
            activeLink.classList.add('active');
            const indicator = activeLink.querySelector('span');
            if (indicator) {
              indicator.style.width = '100%';
            }
          }
        }
      });
    }, observerOptions);

    // Observe all sections
    document.querySelectorAll('section[id]').forEach(section => {
      sectionObserver.observe(section);
    });

    // Header scroll effect
    let lastScrollY = window.scrollY;
    
    const handleScroll = () => {
      const currentScrollY = window.scrollY;
      
      if (mainNav) {
        if (currentScrollY > 100) {
          mainNav.classList.add('scrolled');
        } else {
          mainNav.classList.remove('scrolled');
        }
      }
      
      lastScrollY = currentScrollY;
    };

    // Throttle scroll events for better performance
    let ticking = false;
    const requestTick = () => {
      if (!ticking) {
        requestAnimationFrame(handleScroll);
        ticking = true;
        setTimeout(() => { ticking = false; }, 10);
      }
    };

    window.addEventListener('scroll', requestTick);
  });
</script>
<style>
  #main-nav {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    min-height: 60px;
    overflow: visible;
  }

  @media (prefers-color-scheme: dark) {
    #main-nav {
      background: rgba(0, 0, 0, 0.1);
      border: 1px solid rgba(255, 255, 255, 0.1);
    }
  }

  /* Efecto de scroll mejorado */
  #main-nav.scrolled {
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(20px);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.2);
    min-height: 60px;
  }

  @media (prefers-color-scheme: dark) {
    #main-nav.scrolled {
      background: rgba(0, 0, 0, 0.15);
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
      border: 1px solid rgba(255, 255, 255, 0.1);
    }
  }

  .nav-link.active {
    @apply text-blue-600 dark:text-blue-400;
  }

  .nav-link-mobile.active {
    @apply text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-900/20;
  }

  /* Smooth transitions */
  .nav-link, .nav-link-mobile {
    transition: all 0.3s ease;
    line-height: 1.2;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Evitar que el texto se corte */
  #nav-items {
    height: auto;
    min-height: 44px;
    display: flex;
    align-items: center;
  }

  /* Mejor espaciado en el header */
  header {
    padding-top: 8px;
    padding-bottom: 8px;
  }
</style>
